app_name=ai_school_agent_server
app_env=dev
app_host=127.0.0.1
app_port=8000
debug=true

database_url=postgresql+psycopg2://postgres:123456@127.0.0.1:5432/ai_school_db?client_encoding=utf8

jwt_secret_key=replace_me
jwt_algorithm=HS256
jwt_expire_minutes=120

openai_api_key=sk-76015da1629945a49ea00c02345bb193
openai_base_url=https://coding.dashscope.aliyuncs.com/v1
openai_model=qwen3.5-plus
llm_provider=openai


knowledge_dir=docs/knowledge
rag_top_k=3
rag_chunk_size=300
rag_chunk_overlap=50
policy_handbook_enabled=true
policy_handbook_sql_top_k=3
policy_handbook_vector_top_k=3
policy_handbook_jsonl_path=docs/knowledge/policy_handbook_nodes.jsonl
policy_handbook_auto_seed_on_startup=true

embedding_provider=openai
embedding_api_key=sk-76015da1629945a49ea00c02345bb193
embedding_base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
embedding_model=text-embedding-v4
embedding_dimensions=512

self_iteration_enable_web_research=true
self_iteration_enable_db_research=true

serper_api_key= f4c85b4dae883625b455b4bb97e86b97565fc2bc
serper_search_url=https://google.serper.dev/search

self_iteration_allowed_domains=
self_iteration_db_allowlist_tables=roles,permissions,users,student_profiles,teacher_profiles,courses,schedule_entries,exam_schedules,course_sections,student_course_plans,student_completed_courses,course_prerequisites,course_enrollment_requests,course_enrollment_request_items,resources,resource_bookings,integrity_score_records,approval_templates,zero_form_approval_requests,notifications,pending_actions,agent_sessions,agent_messages,agent_session_memories,tool_execution_logs,audit_logs